{
  "title": "Atlas AI — Overview",
  "uid": "atlas-overview",
  "version": 1,
  "schemaVersion": 39,
  "panels": [
    {
      "title": "CPU Usage",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"atlas-api\"}[5m]) * 100",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "title": "Memory Usage",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"atlas-api\"}",
          "legendFormat": "Memory"
        }
      ]
    },
    {
      "title": "HTTP Request Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"atlas-api\"}[5m])",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "title": "Active Database Connections",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"atlas_ai_dev\"}",
          "legendFormat": "connections"
        }
      ]
    }
  ],
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" }
}
