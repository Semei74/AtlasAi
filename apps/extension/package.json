    "tamagui": "^2.0.0",
    "@tamagui/core": "^2.0.0",
    "@tanstack/react-query": "^5.70.0",
    "zustand": "^5.0.0",
    "i18next": "^24.0.0",
    "react-i18next": "^15.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
