# ─────────────────────────────────────────────
# Atlas AI — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env files to version control.
# ─────────────────────────────────────────────

# Application
APP_NAME=AtlasAI
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
SERVICE_NAME=atlas-api
LOG_LEVEL=debug
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=atlas_ai
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_BUCKET=atlas-ai

# Search (OpenSearch)
SEARCH_HOST=localhost
SEARCH_PORT=9200
SEARCH_USERNAME=
SEARCH_PASSWORD=

# Authentication (JWT)
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=atlas-ai

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Monitoring
SENTRY_DSN=

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@atlas-ai.local
