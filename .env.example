# ─────────────────────────────────────────────
# Atlas AI — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env files to version control.
#
# Variables marked [REQUIRED] must be set for the application to start.
# Variables marked [OPTIONAL] have safe defaults.
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=AtlasAI
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=debug
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000        # Comma-separated list. Wildcard (*) is rejected.

# ── Database (PostgreSQL) ────────────────────
# [REQUIRED] Primary connection string used at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlas_ai?schema=public

# [REQUIRED] Direct (non-pooled) connection for Prisma migrations (migrate deploy).
# In production with PgBouncer, this must point to a direct database endpoint.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/atlas_ai?schema=public

# ── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Object Storage (MinIO / S3) ──────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_BUCKET=atlas-ai

# ── Search (OpenSearch) ──────────────────────
SEARCH_HOST=localhost
SEARCH_PORT=9200
SEARCH_USERNAME=
SEARCH_PASSWORD=

# ── Authentication (JWT) ─────────────────────
# [REQUIRED] Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=atlas-ai

# ── AI Providers ─────────────────────────────
# At least one provider API key is required for AI Gateway to function.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Local inference (no API key required).
OLLAMA_BASE_URL=http://localhost:11434

# ── AI Gateway ───────────────────────────────
AI_GATEWAY_ENABLED=true
AI_GATEWAY_RATE_LIMIT=60                    # Requests per minute
AI_GATEWAY_TIMEOUT=30000                    # Milliseconds

# ── Monitoring ───────────────────────────────
SENTRY_DSN=

# ── Email (SMTP) ─────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@atlas-ai.local
